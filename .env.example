# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is listed in .gitignore.
#
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authentication_db?schema=public"

# Application base URL (used for constructing password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment — set to "production" in production deployments
NODE_ENV="development"

# SMTP Configuration for Nodemailer (Gmail)
# IMPORTANT: For Gmail, use an App Password if 2FA is enabled.
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ─────────────────────────────────────────────────────────────────────────────
# Assessment 3: AI Integration Slice
# ─────────────────────────────────────────────────────────────────────────────
# All values below are PLACEHOLDERS only.
# Open questions must be resolved before filling in real values.
# See ARCHITECTURE.md §23 for the full list of open decisions.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider (open question: ARCHITECTURE.md §23 item 1) ──────────────────
# Enter your API key manually — never share or commit this value.
# AI_API_KEY="your-ai-provider-api-key"

# Model identifiers — set once provider and models are confirmed.
# AI_ROLE1_MODEL_ID="<role-1-model-id>"
# AI_ROLE2_MODEL_ID="<role-2-model-id>"

# ── Role tuning (open question: items 5, 6) ───────────────────────────────────
# Timeout in milliseconds for each role's provider call.
# AI_ROLE1_TIMEOUT_MS="<timeout-ms>"
# AI_ROLE2_TIMEOUT_MS="<timeout-ms>"

# Maximum output tokens for each role.
# AI_ROLE1_MAX_OUTPUT_TOKENS="<token-count>"
# AI_ROLE2_MAX_OUTPUT_TOKENS="<token-count>"

# Temperature for each role (0.0–1.0 or provider range).
# AI_ROLE1_TEMPERATURE="<value>"
# AI_ROLE2_TEMPERATURE="<value>"

# ── Retry policy (open question: item 6) ─────────────────────────────────────
# AI_MAX_ATTEMPTS="<number>"
# AI_BACKOFF_BASE_MS="<milliseconds>"

# ── Worker concurrency (open question: item 4) ───────────────────────────────
# AI_WORKER_CONCURRENCY="<number>"

# ── Rate limits (open question: item 3) ──────────────────────────────────────
# Upload / processing trigger
# AI_UPLOAD_RATE_MAX="<requests>"
# AI_UPLOAD_RATE_WINDOW_MS="<milliseconds>"

# Follow-up action
# AI_FOLLOWUP_RATE_MAX="<requests>"
# AI_FOLLOWUP_RATE_WINDOW_MS="<milliseconds>"

# ── File limits (open question: items 7, 8) ───────────────────────────────────
# Maximum file size in bytes.
# AI_MAX_FILE_SIZE_BYTES="<bytes>"
# Maximum files per submission.
# AI_MAX_FILES_PER_SUBMISSION="<count>"
# Comma-separated list of allowed MIME types.
# AI_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ── Storage (open question: item 2) ──────────────────────────────────────────
# For local development equivalent: absolute path to uploads directory.
# AI_LOCAL_STORAGE_PATH="./uploads"
# For production object storage: bucket name, region, endpoint (provider-specific).
# AI_STORAGE_BUCKET="<bucket-name>"
# AI_STORAGE_REGION="<region>"
